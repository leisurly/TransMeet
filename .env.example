# TransMeet 環境變數設定
# 複製此檔案為 .env 並填入實際的值

# OpenAI API 設定 (用於 LLM 摘要分析)
# 如果沒有設定，LLM 功能將無法使用，但基本的語音轉文字功能仍可正常運作
OPENAI_API_KEY=your_openai_api_key_here

# 應用程式設定
APP_ENV=development  # development, production
DEBUG=true
LOG_LEVEL=INFO

# 伺服器設定
HOST=0.0.0.0
PORT=8000

# 檔案上傳設定
MAX_FILE_SIZE=100  # MB
UPLOAD_TIMEOUT=300  # 秒

# Whisper 模型設定
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_LANGUAGE=zh

# 資料庫設定 (如果未來需要)
# DATABASE_URL=sqlite:///./transmeet.db

# 快取設定
CACHE_TTL=3600  # 秒

# 安全性設定
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# 日誌設定
LOG_FILE=logs/transmeet.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
